    "data": {
      "title": "Isotope shifts and hyperfine structure in the 399-nm 1S0-1P1 transition in ytterbium",
      "authors": "Kleinert, M.; Dahl, M. E. G.; Bergeson, S.",
      "year": 2016,
      "doi": "10.1103/PhysRevA.94.052511",
      "journal": "Physical Review A",
      "notes": "arXiv:1609.02218v2. Isotope shifts for all stable Yb isotopes on the 399nm 1S0->1P1 line relative to 174Yb, measured using an optical frequency comb. Also provides A(1P1, 171Yb) = -212.33(30) MHz (Table 5). Absolute frequency of 174Yb: 751526533.49(33) MHz (Section V.3). 173Yb F=3/2 component not resolved; A(1P1, 173Yb) derived from F=5/2 and F=7/2 components in Table 3.",
      "data_types": ["isotope_shift", "hyperfine_constant"]
    }
